# Vireo v3.1 - environment variables (copy to .env)

# Server
VIREO_HOST=0.0.0.0
VIREO_PORT=5000
VIREO_COMPLIANCE_MODE=strict

# Paths
VIREO_NONCE_DB=nonces.db
VIREO_DID_REGISTRY=did_registry.json

# LLM provider API keys (optional)
MISTRAL_API_KEY=
ALEPH_ALPHA_API_KEY=
COHERE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
QWEN_API_KEY=
DEEPSEEK_API_KEY=

# Local
OLLAMA_URL=http://localhost:11434

# Redis (optional)
REDIS_URL=redis://localhost:6379/0