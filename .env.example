# [file name]: .env.example
# ============================================================
# VIREO LLM CONFIGURATION
# ============================================================

# Головний провайдер: ollama | claude | openai | gemini | mistral | hybrid
LLM_PROVIDER=ollama

# Режим: auto (автоматичний вибір), manual (ручний вибір)
LLM_MODE=auto

# ============================================================
# 1. OLLAMA (локальний, безкоштовний)
# ============================================================
OLLAMA_MODEL=qwen2.5-coder:latest
OLLAMA_HOST=http://localhost:11434
OLLAMA_TIMEOUT=60

# ============================================================
# 2. CLAUDE (Anthropic) — ВСТАВТЕ СВІЙ КЛЮЧ
# ============================================================
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-3-sonnet-20241022

# ============================================================
# 3. OPENAI (GPT-4) — ВСТАВТЕ СВІЙ КЛЮЧ
# ============================================================
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4-turbo-preview

# ============================================================
# 4. GOOGLE GEMINI — ВСТАВТЕ СВІЙ КЛЮЧ
# ============================================================
GOOGLE_API_KEY=...
GEMINI_MODEL=gemini-1.5-pro

# ============================================================
# 5. MISTRAL AI — ВСТАВТЕ СВІЙ КЛЮЧ
# ============================================================
MISTRAL_API_KEY=...
MISTRAL_MODEL=mistral-large-latest

# ============================================================
# НАЛАШТУВАННЯ
# ============================================================
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=1000
HYBRID_SIMPLE_THRESHOLD=0.4
HYBRID_PROVIDER_SIMPLE=ollama
HYBRID_PROVIDER_COMPLEX=claude