{
  "name": "@vireo-ai/sdk",
  "version": "3.0.0",
  "description": "Vireo TypeScript SDK — AI-to-AI Communication Language",
  "author": "Serhii (serhohro)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/vireo-ai/vireo-ai-communicator-3"
  },
  "homepage": "https://docs.vireo.ai",
  "keywords": [
    "vireo",
    "ai",
    "agent",
    "protocol",
    "communication",
    "ai-to-ai",
    "typescript"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "require": "./dist/client.js",
      "import": "./dist/client.mjs"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "require": "./dist/agent.js",
      "import": "./dist/agent.mjs"
    },
    "./wire": {
      "types": "./dist/wire_format.d.ts",
      "require": "./dist/wire_format.js",
      "import": "./dist/wire_format.mjs"
    },
    "./validator": {
      "types": "./dist/validator.d.ts",
      "require": "./dist/validator.js",
      "import": "./dist/validator.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write src",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test",
    "docs": "typedoc"
  },
  "dependencies": {
    "@noble/ed25519": "^2.1.0",
    "@noble/hashes": "^1.3.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.1",
    "tsup": "^7.2.0",
    "typedoc": "^0.25.4",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "volta": {
    "node": "18.17.0",
    "npm": "10.2.0"
  }
}