## 5. `editors/sublime/Vireo.sublime-syntax`

```yaml
# [file name]: editors/sublime/Vireo.sublime-syntax
%YAML 1.2
---
name: Vireo
file_extensions:
  - v
  - vireo
scope: source.vireo

variables:
  identifier: '[a-zA-Z_][a-zA-Z0-9_]*'
  number: '\b[0-9]+(\.[0-9]+)?\b'
  string: '".*?"'

contexts:
  main:
    - include: comments
    - include: keywords
    - include: types
    - include: functions
    - include: decorators
    - include: numbers
    - include: strings
    - include: operators

  comments:
    - match: '//'
      scope: comment.line.double-slash.vireo
      push: line_comment
    - match: '/\*'
      scope: comment.block.vireo
      push: block_comment

  line_comment:
    - meta_scope: comment.line.double-slash.vireo
    - match: $
      pop: true

  block_comment:
    - meta_scope: comment.block.vireo
    - match: '\*/'
      pop: true

  keywords:
    - match: '\b(let|const|fn|return|if|else|for|while|print|model|train|predict|evaluate|agent|negotiation|contract|import|export|pub|module|use)\b'
      scope: keyword.control.vireo

  types:
    - match: '\b(Tensor|Int|F32|F64|Bool|Str|List|Dict|Signature|DID)\b'
      scope: storage.type.vireo

  functions:
    - match: '\b(dense|conv2d|maxpool2d|batch_norm|dropout|relu|sigmoid|tanh|softmax|load|save|load_model|matmul|transpose|reshape|flatten|sum|mean|max|min|normalize|standardize|clip|sqrt|exp|log|sin|cos|tan|predict|sign|verify|generate)\b'
      scope: support.function.vireo

  decorators:
    - match: '@(neural|gpu|jit|parallel|distributed)'
      scope: entity.name.tag.vireo

  numbers:
    - match: '\b[0-9]+(\.[0-9]+)?\b'
      scope: constant.numeric.vireo

  strings:
    - match: '"'
      scope: string.quoted.double.vireo
      push: string_content

  string_content:
    - meta_scope: string.quoted.double.vireo
    - match: '"'
      pop: true
    - match: '\\.'
      scope: constant.character.escape.vireo

  operators:
    - match: '[+\-*/=<>!?:]+'
      scope: keyword.operator.vireo