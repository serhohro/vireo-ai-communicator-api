// Vireo Language Grammar (Lark)
// ============================================================
// Version: 1.4.5 — An Executable Coordination Language
// ============================================================

// ============================================================
// PRECEDENCE
// ============================================================

%left "or"
%left "and"
%left "==" "!=" ">" "<" ">=" "<="
%left "+" "-"
%left "*" "/"
%right "not"
%left "."

// ============================================================
// TERMINALS
// ============================================================

_NL: /[\n\r]+/
_WS: /[ \t]+/
_COMMENT: "//" /[^\n]*/
_BLOCK_COMMENT: "/*" /(.|\n)*?/ "*/"

FLOAT: /[0-9]+\.[0-9]+/
NUMBER: /[0-9]+/
STRING: /"([^"\\]|\\\\.)*"/
NAME: /[a-zA-Z_][a-zA-Z0-9_]*/
BOOL: "true" | "false"

%ignore _WS
%ignore _COMMENT
%ignore _BLOCK_COMMENT

// ============================================================
// PROGRAM
// ============================================================

program: (import_def | statement | model_def | agent_def | contract_def | negotiation_def)*

// ============================================================
// IMPORTS
// ============================================================

import_def: "import" NAME
import_from: "from" NAME "import" NAME

// ============================================================
// STATEMENTS
// ============================================================

statement: variable_def | assign_def | function_def | print_stmt | return_stmt | if_stmt | while_stmt | for_stmt | block

variable_def: "let" NAME "=" expression
assign_def: NAME "=" expression
function_def: "fn" NAME "(" [parameters] ")" block
print_stmt: "print" "(" expression ")" | "print" STRING
return_stmt: "return" expression
if_stmt: "if" expression block ["else" (block | if_stmt)]
while_stmt: "while" expression block
for_stmt: "for" NAME "in" expression block

// ============================================================
// BLOCK
// ============================================================

block: "{" (_NL* statement (_NL+ statement)*)? _NL* "}"

// ============================================================
// PARAMETERS
// ============================================================

parameters: NAME ("," NAME)*

// ============================================================
// MODELS
// ============================================================

model_def: "model" NAME "{" _NL* model_body _NL* "}"
model_body: (layer_def | activation_def | loss_def | optimizer_def | training_param) (_NL+ (layer_def | activation_def | loss_def | optimizer_def | training_param))*

// Layers
layer_def: "layer" layer_type "(" [arguments] ")"
layer_type: "Dense" | "Conv2D" | "MaxPool2D" | "AvgPool2D" | "BatchNorm" | "Dropout" | "Flatten" | "LSTM" | "GRU" | "BiLSTM" | "Attention" | "Transformer" | "Linear" | "Embedding" | "LayerNorm"

// LSTM with parameters
lstm_layer: "LSTM" "(" NUMBER "," NUMBER ["," "num_layers=" NUMBER] ["," "return_sequences=" ("True" | "False")] ["," "activation=" activation_type] ")"
dense_layer: "Dense" "(" NUMBER "," NUMBER ")"
conv2d_layer: "Conv2D" "(" NUMBER "," NUMBER "," NUMBER ["," "stride=" NUMBER] ["," "padding=" NUMBER] ")"
dropout_layer: "Dropout" "(" NUMBER ("," "rate=" NUMBER)? ")"

// Arguments
arguments: expression ("," expression)*

// Activations
activation_def: "activation" activation_type
activation_type: "ReLU" | "Sigmoid" | "Tanh" | "Softmax" | "LeakyReLU" | "ELU" | "GELU" | "Swish" | "Mish" | "SiLU"

// Loss functions
loss_def: "loss" loss_type
loss_type: "CrossEntropy" | "MSE" | "MAE" | "Huber" | "KLDiv" | "BCE" | "BCEWithLogits" | "CTCLoss"

// Optimizers
optimizer_def: "optimizer" optimizer_type "(" [optimizer_params] ")"
optimizer_type: "Adam" | "SGD" | "RMSprop" | "AdamW" | "Adamax" | "Nadam" | "Lion" | "Lamb" | "RAdam"

// Optimizer parameters
optimizer_params: param ("," param)*
param: NAME "=" NUMBER | NAME "=" FLOAT

// Training parameters
training_param: NAME "=" (NUMBER | FLOAT | STRING)

// ============================================================
// AGENTS
// ============================================================

agent_def: "agent" NAME "{" _NL* agent_body _NL* "}"
agent_body: (identity_def | capability_def | role_def | system_prompt_def) (_NL+ (identity_def | capability_def | role_def | system_prompt_def))*

identity_def: "identity" ":" STRING
capability_def: "capability" NAME ["(" [parameters] ")"] ["{" _NL* capability_body _NL* "}"]
capability_body: (description_def | input_schema_def | output_schema_def) (_NL+ (description_def | input_schema_def | output_schema_def))*

description_def: "description" ":" STRING
input_schema_def: "input" ":" type
output_schema_def: "output" ":" type

role_def: "role" ":" NAME
system_prompt_def: "system_prompt" ":" STRING

// ============================================================
// CONTRACTS
// ============================================================

contract_def: "contract" NAME "{" _NL* contract_body _NL* "}"
contract_body: (field_def | condition_def | invariant_def) (_NL+ (field_def | condition_def | invariant_def))*

field_def: NAME ":" type ["=" value]
condition_def: "condition" "{" _NL* expression _NL* "}"
invariant_def: "invariant" "{" _NL* expression _NL* "}"

type: "Int" | "Float" | "String" | "Bool" | "Tensor" | "List" "[" type "]" | "Map" "[" type "," type "]"

// ============================================================
// NEGOTIATIONS
// ============================================================

negotiation_def: "negotiate" NAME "{" _NL* negotiation_body _NL* "}"
negotiation_body: (party_def | timeout_def | max_rounds_def | on_offer_def | on_commit_def | on_reject_def) (_NL+ (party_def | timeout_def | max_rounds_def | on_offer_def | on_commit_def | on_reject_def))*

party_def: "party" NAME ":" NAME
timeout_def: "timeout" "=" NUMBER "s"
max_rounds_def: "max_rounds" "=" NUMBER
on_offer_def: "on" "offer" "(" NAME ":" NAME ")" block
on_commit_def: "on" "commit" block
on_reject_def: "on" "reject" block

// ============================================================
// EXPRESSIONS
// ============================================================

expression: logical_or
logical_or: logical_and ("or" logical_and)*
logical_and: comparison ("and" comparison)*
comparison: arithmetic ((">" | "<" | "==" | "!=" | ">=" | "<=") arithmetic)*
arithmetic: term ("+" | "-" term)*
term: factor ("*" | "/" factor)*
factor: unary_op | "(" expression ")" | NUMBER | FLOAT | STRING | NAME | BOOL | tensor_ops | function_call | list_expr | map_expr | lambda_expr

unary_op: ("-" | "+" | "not") factor

tensor_ops: tensor_expr ("." ("matmul" | "transpose" | "reshape" | "flatten" | "sum" | "mean" | "max" | "min" | "argmax" | "argmin") "(" [arguments] ")")*

tensor_expr: "Tensor" "(" [expression ("," expression)*] ")"

function_call: NAME "(" [expression ("," expression)*] ")"
list_expr: "[" [expression ("," expression)*] "]"
map_expr: "{" [NAME ":" expression ("," NAME ":" expression)*] "}"
lambda_expr: "|" parameters "|" expression

// ============================================================
// VALUES
// ============================================================

value: NUMBER | FLOAT | STRING | BOOL | "null" | list_expr | map_expr
