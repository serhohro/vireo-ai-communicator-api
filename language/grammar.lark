// Vireo Language Grammar v2.0.1
// Based on Lark parser

// Program
program: (import_statement | agent_definition | contract_definition | statement)*

// Imports
import_statement: "import" IDENTIFIER

// Agent
agent_definition: "agent" STRING "{" (capability_definition | state_definition)* "}"

capability_definition: "capability" IDENTIFIER "{" 
    (input_definition)+ 
    [output_definition]
    ["action" ":" STRING]
    ["cost" ":" NUMBER]
    ["estimated_tokens" ":" NUMBER]
    ["timeout_sec" ":" NUMBER]
    ["requires" ":" "[" IDENTIFIER ("," IDENTIFIER)* "]"]
    ["async" ":" BOOLEAN]
"}"

input_definition: "input" ":" IDENTIFIER ":" TYPE ["=" value]
output_definition: "output" ":" IDENTIFIER ":" TYPE

state_definition: "state" ":" "{" (IDENTIFIER ":" value)+ "}"

// Contract
contract_definition: "contract" STRING "{" 
    "parties" ":" "[" IDENTIFIER ("," IDENTIFIER)* "]"
    "terms" ":" "{" (term_entry)* "}"
    "obligations" ":" "{" (obligation_entry)+ "}"
    ["condition" ":" expression]
    ["on_failure" ":" STRING]
"}"

term_entry: IDENTIFIER ":" value

obligation_entry: IDENTIFIER ":" "{" 
    "action" ":" IDENTIFIER
    "input" ":" "{" (field_entry)* "}"
    ["output" ":" "{" (field_entry)* "}"]
    ["depends_on" ":" "[" IDENTIFIER ("," IDENTIFIER)* "]"]
"}"

field_entry: IDENTIFIER ":" value

// Statements
statement: execute_statement | output_statement | if_statement | loop_statement

execute_statement: "execute" IDENTIFIER "(" [argument_list] ")" ["->" IDENTIFIER]

output_statement: "output" expression

if_statement: "if" expression "{" statement* "}" ["else" "{" statement* "}"]

loop_statement: "loop" (NUMBER | "while" expression | "for" IDENTIFIER "in" expression) "{" statement* "}"

argument_list: IDENTIFIER ":" value ("," IDENTIFIER ":" value)*

// Expressions
expression: comparison

comparison: addition (("==" | "!=" | "<" | ">" | "<=" | ">=") addition)*

addition: multiplication (("+" | "-") multiplication)*

multiplication: unary (("*" | "/") unary)*

unary: ("-" | "!") unary | primary

primary: STRING | NUMBER | BOOLEAN | "null" | "true" | "false"
    | IDENTIFIER
    | "$ref" "." IDENTIFIER ("." IDENTIFIER)*
    | "{" field_entry ("," field_entry)* "}"
    | "[" [expression ("," expression)*] "]"
    | "(" expression ")"
    | IDENTIFIER "(" [argument_list] ")"

// Values
value: STRING | NUMBER | BOOLEAN | "null" | "true" | "false"
    | "[" [value ("," value)*] "]"
    | "{" field_entry ("," field_entry)* "}"
    | "$ref" "." IDENTIFIER ("." IDENTIFIER)*// Types
TYPE: "string" | "number" | "boolean" | "json" | "array" | "map" | "agent" | "contract" | "capability"

// Tokens
IDENTIFIER: /[a-zA-Z_][a-zA-Z0-9_]*/
STRING: /"[^"]*"/
NUMBER: /[0-9]+(\.[0-9]+)?/
BOOLEAN: "true" | "false"

// Comments
COMMENT: "//" /[^\n]*/ -> ignore
WS: /[ \t\n\r]+/ -> ignore