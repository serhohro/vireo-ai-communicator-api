{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Vireo",
    "patterns": [
        { "include": "#decorators" },
        { "include": "#keywords" },
        { "include": "#types" },
        { "include": "#functions" },
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#numbers" },
        { "include": "#operators" },
        { "include": "#constants" }
    ],
    "repository": {
        "decorators": {
            "patterns": [{
                "name": "entity.name.tag.vireo",
                "match": "@(neural|parallel|distributed|profile)\\b"
            }]
        },
        "keywords": {
            "patterns": [{
                "name": "keyword.control.vireo",
                "match": "\\b(if|else|for|while|return|match|break|continue|loop)\\b"
            }, {
                "name": "keyword.declaration.vireo",
                "match": "\\b(let|const|fn|struct|enum|impl|module|import|export|pub|fn)\\b"
            }, {
                "name": "keyword.other.vireo",
                "match": "\\b(True|False|None)\\b"
            }]
        },
        "types": {
            "patterns": [{
                "name": "storage.type.vireo",
                "match": "\\b(Int|F32|F64|Bool|Str|Tensor|List|Dict|Maybe|Variable)\\b"
            }]
        },
        "functions": {
            "patterns": [{
                "name": "entity.name.function.vireo",
                "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\("
            }, {
                "name": "support.function.vireo",
                "match": "\\b(print|dense|conv2d|maxpool2d|batch_norm|dropout|relu|sigmoid|tanh|softmax|load|save|load_model|matmul|transpose|reshape|flatten|sum|mean|max|min|normalize|standardize|clip|sqrt|exp|log|sin|cos|tan)\\b"
            }]
        },
        "comments": {
            "patterns": [{
                "name": "comment.line.double-slash.vireo",
                "match": "//.*$"
            }, {
                "name": "comment.block.vireo",
                "begin": "/\\*",
                "end": "\\*/"
            }]
        },
        "strings": {
            "patterns": [{
                "name": "string.quoted.double.vireo",
                "begin": "\"",
                "end": "\"",
                "patterns": [
                    { "name": "constant.character.escape.vireo", "match": "\\\\." }
                ]
            }, {
                "name": "string.quoted.single.vireo",
                "begin": "'",
                "end": "'",
                "patterns": [
                    { "name": "constant.character.escape.vireo", "match": "\\\\." }
                ]
            }]
        },
        "numbers": {
            "patterns": [{
                "name": "constant.numeric.vireo",
                "match": "\\b\\d+(\\.\\d+)?\\b"
            }]
        },
        "operators": {
            "patterns": [{
                "name": "keyword.operator.vireo",
                "match": "\\+|-|\\*|/|==|!=|<=|>=|<|>|&&|\\|\\||!|=|\\+=|-=|\\*=|/="
            }]
        },
        "constants": {
            "patterns": [{
                "name": "constant.other.vireo",
                "match": "\\b(True|False|None)\\b"
            }]
        }
    },
    "scopeName": "source.vireo"
}